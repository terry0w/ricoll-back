# Database. Set DATABASE_URL, or leave it empty and use the DB_* variables
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ricoll
DB_PASSWORD=ricoll
DB_DATABASE=ricoll
DB_SSL=false

NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Frontend URL (email links and OAuth redirect)
APP_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
